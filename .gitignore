__pycache__/
*.pyc
.venv/
.pytest_cache/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
.env

# Datos por cliente (generados por scripts/nuevo_cliente.py, mismo patrón
# que Contalibra/Restolibra/Gestiolibra/MedLibra) y datos locales de -dev.
/clientes/
dev-data/

# La config de la instancia: guarda el Access Token de MercadoPago y la
# contraseña de SMTP. Los otros cuatro productos con esta pantalla ya la
# ignoraban y VentaLibra era el único que no — con el bind mount `./:/app` del
# servicio -dev, el archivo cae en la raíz del checkout del VPS.
config.json

# Config de NPM (credenciales de Nginx Proxy Manager para scripts/npm_*.py).
scripts/.npm_config.json

# Artefactos de cobertura (agregado 2026-07-31, junto con el paso de coverage
# en el CI). Son salida de la herramienta, se regeneran en cada corrida y el
# .coverage es un binario de ~100-250 KB: no van al repo.
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/
frontend/coverage/

# ── Solo-VPS (agregado 2026-08-02 al desplegar el backoffice de la suite) ────
# Nada de esto se versiona: son archivos que solo existen en el servidor y
# varios llevan secretos. Un untracked con credenciales adentro esta a un
# `git add -A` de entrar al repo.
# compose del backoffice, generado en el VPS
admin/
# venv de los scripts de provisioning
.venv-scripts/
